# --- dependencies & generated client libs -------------------------------------------------------
node_modules/
# a local npm cache (npm_config_cache=./.npm-cache, npm ci --cache .npm-cache — GitHub #258)
.npm-cache/
# copied from node_modules by tools/vendor.mjs (postinstall); never commit third-party builds
public/vendor/
public/js/independent/engine/

# --- game assets: (c) Hypergryph / Yostar, fetched or extracted locally, NEVER committed ----------
# tools/fetch-assets.mjs → public/assets/** (~270 MB) and public/fonts/** (+ fonts.css)
public/assets/
public/fonts/
# tools/local-extract/extract.py → public/assets/local/** and this per-machine manifest
# (optional: the client and the tests work without it; docs/DEPLOY.md §6 lists what falls back)
# Battlefield scenes (0.2.5): extracted files live under public/assets/local/scene/ (already ignored by
# public/assets/ above). Downloaded bundles live in .cache/official-scenes/ (already ignored by .cache/ below).
# The repository never stores those official files.
data/local-assets.json
data/local-fx.json
# Assault's native summon models require a committed asset manifest; retain that mode manifest while
# keeping other per-machine local extraction manifests ignored.
!data/local-assets.json
# download caches, upstream tables, ledgers, reports, setup state
.cache/

# --- Python (optional local-client extraction) ----------------------------------------------------
.venv*/
venv/
__pycache__/
*.py[cod]

# --- content packs (docs/PACKS.md): the pack index for a static host, generated by `node tools/packs.mjs index`
# (the server answers /packs/index.json itself; tools/package.mjs writes this file into the release zips) -----------
packs/index.json

# --- tests & logs ----------------------------------------------------------------------------------
test/e2e/out/
logs/
*.log

# --- per-machine config (scripts/install-service-windows.ps1) ------------------------------------
scripts/service.env.cmd
scripts/service.env.ps1
.env
.env.*

# --- OS / editor clutter ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
.claude/
# tools/sim-check.mjs: the corpus and its Node traces for /dev/sim-check.html
public/dev/simcheck/data/

# --- project-local runtime and release trees ----------------------------------------------------
# Machine/runtime outputs (assault saves and downloaded art of a source run live in runtime/), never source.
/runtime/
/publish/
/caddy/
/.omni/
/.worktrees/

# --- external reference inputs and copyrighted or hand-drawn art ---------------------------------
# Raw game dumps, the assault asset store and the resonance research bundle stay in the local material store;
# players download the art on first start (tools/assault/player-assets.mjs from data/assault-assets.json).
data/assault-sources/
data/resonance-reference/
public/resonance-references.zip
# The 2B study pages (public/dev/diy-2b) and the Spine reference results keep their code and data in Git; the
# hand-drawn 2B icons and Spine model, and the result renders of official operator models, stay local.
public/dev/diy-2b/icons/
public/dev/diy-2b/model/
public/dev/spine-reference/results-images/
# Resonance art bundles (component / emblem renders, the Spine archive models) are mounted or downloaded at the
# same URL paths; they are not part of the GPL source tree.
public/css/resonance-components/*.webp
public/css/resonance-emblems/*.webp
public/dev/spine-archive/model/
